{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "giftwala",
	"compatibility_date": "2026-09-25",
	"main": "src/worker.js",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"migrations_dir": "migrations",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "giftwala_db",
			"database_name": "giftwala-db",
			"database_id": "de60f448-4afc-4838-bb4e-b4e3f46348f2",
			"remote": true
		}
	]
}